{
  "name": "fan-management-system",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/copy-standalone-assets.js",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "electron:dev": "cross-env NODE_ENV=development ELECTRON_SKIP_NEXT_SERVER=true concurrently --kill-others \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:preview": "cross-env NODE_ENV=production ELECTRON_SKIP_NEXT_SERVER=true concurrently --kill-others \"next start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "next build && node scripts/copy-standalone-assets.js && electron-builder --win --config electron-builder.json"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.2",
    "jose": "^6.2.5",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jest": "^30.4.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.12",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
